NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://gspace:gspace_dev_only@localhost:5432/gspace?schema=public
# Generate a fresh 32+ byte secret locally, e.g. with node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))".
# NEVER use this placeholder as a real secret or commit your generated secret.
AUTH_SECRET=REPLACE_WITH_A_FRESH_RANDOM_SECRET_AT_LEAST_32_BYTES
# Set the following only for the one-time initial administrator bootstrap, then unset.
# BOOTSTRAP_ADMIN_EMAIL=...
# BOOTSTRAP_ADMIN_NAME=...
# BOOTSTRAP_ADMIN_PASSWORD=...
